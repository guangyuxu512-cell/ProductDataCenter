RELEASE_SHA=replace-with-reviewed-commit-sha
DATABASE_URL_FILE=/REPLACE_PRIVATE_DIRECTORY/product_database_url
BACKEND_ENABLE_GROUP_WRITES=false
NAS_NETWORK=REPLACE_EXISTING_NETWORK
NAS_DATA_ROOT=/REPLACE_EXISTING_DATA_ROOT
API_TOKEN_FILE=/REPLACE_PRIVATE_DIRECTORY/product_api_token
WEB_HTPASSWD_FILE=/REPLACE_PRIVATE_DIRECTORY/web_htpasswd
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3612
# lan 模式免网页登录，只允许指定私有网段；确保未通过公网代理暴露。
WEB_ACCESS_MODE=basic
WEB_TRUSTED_CIDR=192.168.0.0/24
