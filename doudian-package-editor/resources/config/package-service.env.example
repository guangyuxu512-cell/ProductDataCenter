# Copy this file to one of these locations before running the packaged EXE:
# 1. %APPDATA%\商品包中心\package-service.env
# 2. The same folder as 商品包中心.exe
#
# Keep PACKAGE_SERVICE_API_KEY unchanged for the desktop app.
# Configure only the server-side gateway/signer values here.

PACKAGE_SERVICE_DATABASE_GATEWAY_BASE_URL=
PACKAGE_SERVICE_DATABASE_GATEWAY_API_KEY=
PACKAGE_SERVICE_DATABASE_GATEWAY_API_KEY_FILE=
PACKAGE_SERVICE_DATABASE_GATEWAY_TIMEOUT_SECONDS=30

PACKAGE_SERVICE_DOUYIN_REMOTE_SIGNER_URL=http://119.29.188.118:8787/sign
PACKAGE_SERVICE_DOUYIN_REMOTE_SIGNER_KEY=
PACKAGE_SERVICE_DOUYIN_REMOTE_SIGNER_KEY_FILE=
PACKAGE_SERVICE_DOUYIN_REMOTE_SIGNER_TIMEOUT_SECONDS=12
