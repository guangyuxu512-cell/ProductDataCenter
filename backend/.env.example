BACKEND_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/product_workbench_test
BACKEND_API_TOKEN=REPLACE_WITH_RANDOM_URLSAFE_TOKEN
BACKEND_ENABLE_GROUP_WRITES=false
BACKEND_DATA_ROOT=/path/to/restored-collector-data
# Optional direct connection; keep disabled until the control-center API is deployed.
BACKEND_CENTRAL_APPLICATION_ENABLED=false
# BACKEND_CENTRAL_APPLICATION_BASE_URL=https://control-center.example
# BACKEND_CENTRAL_APPLICATION_ID=product-library
# BACKEND_CENTRAL_APPLICATION_TOKEN_FILE=/run/secrets/central_application_token
# Optional read-only platform category lookup. Keep disabled until NAS signing is verified.
BACKEND_DOUYIN_CATEGORY_LOOKUP_ENABLED=false
# BACKEND_DOUYIN_SIGNER_URL=http://product-cloud-signer-v1-product-signer-1:8787
# BACKEND_DOUYIN_SIGNER_KEY_FILE=/run/secrets/product_signer_api_key
