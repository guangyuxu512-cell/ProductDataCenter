BACKEND_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/product_workbench_test
BACKEND_API_TOKEN=REPLACE_WITH_RANDOM_URLSAFE_TOKEN
BACKEND_ENABLE_GROUP_WRITES=false
BACKEND_ENABLE_PRODUCT_EDITS=false
BACKEND_ENABLE_SOURCE_CATEGORY_READS=false
# Optional: absolute path of the user-supplied PDD category CSV; mount read-only.
# BACKEND_PDD_CATEGORY_CSV=/pdd-categories/pdd_categories.csv
# BACKEND_PDD_CATEGORY_SHA256=<sha256-of-approved-complete-csv>
BACKEND_DATA_ROOT=/path/to/restored-collector-data
