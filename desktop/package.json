{
  "name": "product-workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "商品云库 Windows 客户端",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "start": "pnpm run build && electron .",
    "package:win": "pnpm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^20.17.19",
    "cross-env": "^7.0.3",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "typescript": "~5.7.3"
  }
}
